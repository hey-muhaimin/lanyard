# Where `next dev` proxies /ops/*. Use the control plane's admin listener, never the public one.
LANYARD_API_ORIGIN=http://localhost:8082
# Develop without a backend: fixture data and a signed-in on-call engineer.
NEXT_PUBLIC_OPS_MOCK=1
# Label shown in the header (prod, staging, local).
NEXT_PUBLIC_OPS_ENV=local
